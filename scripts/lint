#!/usr/bin/env bash
# Linters: repo-level checks always run; application linters are wired by /bootstrap-stack.
#
# Usage: scripts/lint [--fast] [--changed]
#   agent-config  .claude/ skills, agents, rules, hooks, settings + docs links + ADRs (validate_config.py)
#   shell         shellcheck on every bash script (skipped locally if shellcheck is missing; CI has it)
#   python        syntax check of repo tooling (+ ruff if installed)
#   workflows     actionlint on .github/workflows (if installed)
#   app           STACK: the application's analyzers/linters/type checkers

# shellcheck source=lib/common.sh
source "$(dirname "$0")/lib/common.sh"

CHANGED=0
for arg in "$@"; do
  case "$arg" in
    --fast) ;;
    --changed) CHANGED=1 ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown option: $arg" ;;
  esac
done
cd "$REPO_ROOT"
require_python

lint_agent_config() {
  "$PY" scripts/agent/validate_config.py
}

# Every bash script we own: extension-less entrypoints, *.sh files and git hooks.
shell_files() {
  local f
  for f in scripts/* scripts/lib/*.sh scripts/github/*.sh .claude/hooks/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    case "$f" in *.py | *.md | *.txt | *.json | *.yaml | *.yml) continue ;; esac
    if [ "${f##*.}" = "sh" ] || head -n 1 "$f" | grep -Eq '^#!.*(bash|/sh)'; then
      printf '%s\n' "$f"
    fi
  done
}

lint_shell() {
  if ! have shellcheck; then
    log_skip "shellcheck not installed locally (CI runs it). Install: brew/apt/winget install shellcheck"
    return 0
  fi
  local rc=0 files
  files="$(shell_files)"
  if [ "$CHANGED" = 1 ]; then
    files="$(printf '%s\n' "$files" | grep -Fx -f <(changed_files) || true)"
  fi
  [ -z "$files" ] && return 0
  # shellcheck disable=SC2086
  shellcheck --external-sources --source-path=SCRIPTDIR --severity=warning $files || rc=1
  return "$rc"
}

lint_python() {
  local rc=0 files
  files="$(git ls-files '*.py' 2>/dev/null; git ls-files --others --exclude-standard '*.py' 2>/dev/null)"
  [ -z "$files" ] && return 0
  # Syntax check without writing __pycache__.
  # shellcheck disable=SC2086
  "$PY" -c 'import ast, sys
for f in sys.argv[1:]:
    with open(f, encoding="utf-8") as fh:
        ast.parse(fh.read(), f)' $files || rc=1
  if have ruff; then
    # shellcheck disable=SC2086
    ruff check --quiet $files || rc=1
  fi
  return "$rc"
}

lint_workflows() {
  if ! have actionlint; then
    log_skip "actionlint not installed (CI runs it). Install: brew install actionlint | go install github.com/rhysd/actionlint/cmd/actionlint@latest"
    return 0
  fi
  actionlint
}

lint_app() {
  if ! stack_ready; then
    no_stack_note "app lint"
    return 0
  fi
  # STACK: run the application's analyzers / linters / type checkers here, e.g.
  #   flutter analyze --fatal-infos      | pnpm -r lint && pnpm -r typecheck
  #   cargo clippy --all-targets -- -D warnings | vendor/bin/phpstan analyse
  log_warn "ADR-0002 is Accepted but app lint is not wired yet — run /bootstrap-stack."
  return 1
}

run_step "agent-config" lint_agent_config
run_step "shell" lint_shell
run_step "python" lint_python
run_step "workflows" lint_workflows
run_step "app" lint_app
finish_steps

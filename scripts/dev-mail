#!/usr/bin/env bash
# Local IMAP/SMTP server (GreenMail in Docker) seeded with the fixture corpus.
# For development and integration tests only — never point tooling at a real mailbox.
#
# Usage: scripts/dev-mail <command> [args]
#   up              start the server and wait until it is ready (idempotent)
#   seed [args]     append fixtures/email/* into alice's mailbox (args go to seed_mailbox.py, e.g. --bulk 5000)
#   reset           wipe the server (all mailboxes) and seed again
#   send [args]     send a test message over SMTP (default bob -> alice), e.g. --subject "Hello"
#   status          readiness, accounts and per-folder message counts
#   logs            last 200 lines of server logs
#   down            stop and remove the server
#
# Accounts: alice@isupply.test / alice-dev-pw, bob@isupply.test / bob-dev-pw, shared@isupply.test / shared-dev-pw
# Ports (override via env): IMAP 3143, IMAPS 3993, SMTP 3025, SMTPS 3465, REST API 3080

# shellcheck source=lib/common.sh
source "$(dirname "$0")/lib/common.sh"

COMPOSE_FILE="$REPO_ROOT/infra/dev-mail/compose.yaml"
API_PORT="${DEV_MAIL_API_PORT:-3080}"
API="http://127.0.0.1:${API_PORT}/api"
cmd="${1:-}"
[ $# -gt 0 ] && shift
cd "$REPO_ROOT"
require_python

compose() {
  have docker || die "Docker is required for the dev mail server (https://docs.docker.com/get-docker/)."
  docker compose -f "$COMPOSE_FILE" "$@"
}

# http METHOD URL — tiny HTTP client via Python (curl is not guaranteed on Windows).
http() {
  "$PY" - "$1" "$2" <<'PY'
import sys, urllib.request
req = urllib.request.Request(sys.argv[2], method=sys.argv[1])
try:
    with urllib.request.urlopen(req, timeout=5) as r:
        sys.stdout.write(r.read().decode("utf-8", "replace"))
except Exception as e:  # noqa: BLE001 - surface any failure as exit code
    sys.stderr.write(f"{e}\n")
    sys.exit(1)
PY
}

wait_ready() {
  local _
  for _ in $(seq 1 60); do
    if http GET "$API/service/readiness" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

case "$cmd" in
  up)
    compose up -d --wait 2>/dev/null || compose up -d
    wait_ready || die "dev mail server did not become ready in 60s — see: scripts/dev-mail logs"
    log_ok "dev mail server ready — IMAP 127.0.0.1:${DEV_MAIL_IMAP_PORT:-3143}, SMTP 127.0.0.1:${DEV_MAIL_SMTP_PORT:-3025} (alice@isupply.test / alice-dev-pw)"
    ;;
  seed)
    wait_ready || die "dev mail server is not running — run: scripts/dev-mail up"
    "$PY" scripts/email/seed_mailbox.py seed "$@"
    ;;
  reset)
    wait_ready || die "dev mail server is not running — run: scripts/dev-mail up"
    # Full server reset (mailboxes gone, users recreated). Deleting folders over IMAP is avoided on purpose:
    # GreenMail 2.1.3 can drop the connection on DELETE after a purge (see infra/dev-mail/README.md).
    http POST "$API/service/reset" >/dev/null
    wait_ready || die "dev mail server did not come back after reset"
    "$PY" scripts/email/seed_mailbox.py seed "$@"
    ;;
  send)
    wait_ready || die "dev mail server is not running — run: scripts/dev-mail up"
    "$PY" scripts/email/seed_mailbox.py send "$@"
    ;;
  status)
    if ! http GET "$API/service/readiness" >/dev/null 2>&1; then
      log_warn "dev mail server is not running (start it: scripts/dev-mail up)"
      exit 1
    fi
    log_ok "dev mail server is running"
    "$PY" scripts/email/seed_mailbox.py status
    ;;
  logs) compose logs --tail 200 ;;
  down) compose down --remove-orphans ;;
  -h | --help) usage ;;
  *)
    usage
    exit 2
    ;;
esac

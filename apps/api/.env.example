# iSupply Mail API — environment template.
# Local defaults point at the dev services: PostgreSQL + Redis on localhost and the GreenMail dev mail
# server (scripts/dev-mail up). scripts/setup copies this to .env and generates every key.
# Production values are documented in DEPLOYMENT.md. Never commit a real .env.

APP_NAME="iSupply Mail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Where the single-page app is served from (CORS, Sanctum cookies, links).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=isupply_mail
DB_USERNAME=isupply
DB_PASSWORD=isupply-dev-pw

SESSION_DRIVER=redis
SESSION_LIFETIME=20160
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true   (always true in production, behind HTTPS)

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Origins whose requests get cookie (session) authentication: the SPA in dev and production.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# Laravel's own mailer is unused by the app (staff mail goes through the mail engine below).
MAIL_MAILER=log

# --- Mail engine (ADR-0004, ADR-0005) -------------------------------------------------------------
# Domains allowed to sign in. Production: isupply.com.eg. The dev mail server uses isupply.test.
MAIL_DOMAINS=isupply.test
# Provisioned servers. Encryption: ssl (implicit TLS) | starttls | none.
# "none" is refused unless APP_ENV is local/testing AND the host is a loopback address (GreenMail).
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=3143
MAIL_IMAP_ENCRYPTION=none
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=3025
MAIL_SMTP_ENCRYPTION=none
# How the login name is built from the address (%EMAILADDRESS% or %EMAILLOCALPART%).
MAIL_USERNAME_FORMAT=%EMAILADDRESS%
# Set true if the server files sent mail into Sent by itself (Microsoft 365, Gmail).
MAIL_SMTP_SAVES_SENT=false
# Encrypts stored mail passwords; separate from APP_KEY. Generate with: php artisan mail:key
MAIL_CREDENTIALS_KEY=
MAIL_SYNC_INITIAL_WINDOW=1000
MAIL_SYNC_FLAG_WINDOW=500
MAIL_UNDO_SEND_SECONDS=10
MAIL_MAX_ATTACHMENT_MB=25

# --- Realtime (Laravel Reverb) ----------------------------------------------------------------------
REVERB_APP_ID=isupply-mail
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Push notifications (optional; push stays off until configured) ---------------------------------
# Include sender and subject in pushes (off: notifications only say how many messages arrived).
PUSH_INCLUDE_PREVIEW=false
# Web Push (browsers). Generate keys with: php artisan push:vapid
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:it@isupply.com.eg
# Firebase Cloud Messaging (Android): path to the service-account JSON, outside the repository.
FCM_CREDENTIALS_PATH=
# Apple Push Notification service (iOS): token auth with a .p8 key, outside the repository.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=eg.com.isupply.mail
APNS_ENVIRONMENT=sandbox

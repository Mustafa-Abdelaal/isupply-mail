# Local overrides for development. Copy to `.env` (git-ignored) only if you need to change defaults.
# These are throwaway credentials for the LOCAL dev mail server (infra/dev-mail). Never put real
# @isupply.com credentials in any file.

# Dev mail server (GreenMail) host ports — change if they clash with something on your machine.
DEV_MAIL_SMTP_PORT=3025
DEV_MAIL_SMTPS_PORT=3465
DEV_MAIL_IMAP_PORT=3143
DEV_MAIL_IMAPS_PORT=3993
DEV_MAIL_API_PORT=3080

# Seeded dev accounts (see infra/dev-mail/compose.yaml):
#   alice@isupply.test / alice-dev-pw
#   bob@isupply.test   / bob-dev-pw
#   shared@isupply.test / shared-dev-pw

# Skip the Claude Code Stop-hook quality gate for one session (not recommended):
# ISUPPLY_SKIP_STOP_CHECK=1
